{
  "name": "kai-converter",
  "version": "1.0.0",
  "description": "AI-powered karaoke file creator with source separation and lyrics transcription",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "wait-on http://localhost:5174 && electron . --no-sandbox",
    "dev:all": "concurrently --kill-others \"npm run dev\" \"npm run dev:electron\"",
    "setup:python": "node scripts/setup-python.js",
    "setup:binaries": "node scripts/setup-binaries.js",
    "setup:all": "npm run setup:python && npm run setup:binaries",
    "build": "vite build",
    "build:python": "node scripts/build-python.js",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder -mwl"
  },
  "keywords": [
    "karaoke",
    "ai",
    "whisper",
    "demucs",
    "electron",
    "lyrics",
    "transcription"
  ],
  "author": "KAI Converter",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tar": "^7.5.1",
    "vite": "^5.4.2",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.kai.converter",
    "productName": "KAI Converter",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "renderer/dist/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "python-standalone",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src",
        "to": "python-src",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "provisioningProfile": "build/embedded.provisionprofile"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "resources/icon.png",
      "category": "Audio"
    }
  }
}
